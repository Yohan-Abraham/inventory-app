<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>movie inventory</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <%- include('nav') %> 
    <section>

       <div class="section-header">
      <h2>All Genres</h3>

      
      <a href="/genres/new" class="add">+ Add Genre</a>
      
    </div>

      <div class="container">
        <% genres.forEach((genre) => { %>
          <div class="genre-card">
            <div class="title">
              <h4><%= genre.name %></h4>
              <h4>Genre</h4>
            </div>
            <a class="details" href="/genres/<%=genre.id%>">Browse This Genre</a>
            <a class="delete" href="/delete">Delete Genre</a>

          </div>
    <% }) %>
      </div>

    </section>
  </body>
</html>
