<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>movie inventory</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <%- include('nav') %>
    <section>
      <a href="/movies"><- Back to Movies</a>

      <div class="add-movie">
        <form action="" class="add-form" method="POST">
          <label for="title">Title: </label>
          <input type="text" name="title" required />

          <div class="movie-rate-release">
            <div>
              <label for="rating">Rating (0-10): </label>
              <input type="text" name="rating" required />
            </div>
            <div>
              <label for="release_year">Release Year: </label>
              <input type="text" name="release_year" required />
            </div>
          </div>

          <div class="movie-category">
            <% genres.forEach(genre => { %>
               
              <label>
                <span><%=genre.name%></span>
                <input type="checkbox" name="category" value="<%= genre.id %>"> 
              </label>
              
            <% }) %>
          </div>

          <label for="director">Director: </label>
          <input type="text" name="director" required />

          <label for="description">Description: </label>
          <input type="text" name="description"  />

          <button class="add-button" type="submit">Update Movie</button>
        </form>
      </div>
    </section>
  </body>
</html>