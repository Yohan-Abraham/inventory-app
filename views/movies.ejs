<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>movie inventory</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <%- include('nav') %>

  <section>

    <div class="section-header">
      <h2>All Movies</h3>


        <a href="/movies/new" class="add">+ Add Movie</a>

    </div>

    <div class="container">
      <% movies.forEach(movie => { %>

         <div class="card">
            <h3 class="movie-title"><%= movie.title.toUpperCase() %></h3>
            <p class="description"><%=movie.description%></p>
            <div class="release_year"><%= movie.release_year %></div>
           
            <div class="rating"><%= movie.rating %></div>

            <div class="additional-options">
              <a class="details" href="/movies/<%= movie.id %>">Details</a>
              <a class="delete" href="movies/delete/<%= movie.id %>">Delete</a>
            </div>

        </div>

    <% }) %>
    </div>

  </section>

  </body>
</html>
